@{
    ViewData["Title"] = "Home";
}

<div class="row">
    <div class="col-sm-12">
        <div class="momentum-header">
            <h1>Build Momentum One Small Step at a Time</h1>
            <p class="lead mb-0">
                Turn big goals into smaller milestones and simple actions you can actually complete.
            </p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="momentum-card goal-card h-100">
            <h3 class="text-success">
                Set a Goal
                <i class="material-icons">flag</i>
            </h3>
            <p>
                Choose something meaningful you want to accomplish.
            </p>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="momentum-card breakdown-card h-100">
            <h3 class="text-success">Break It Down</h3>
            <p>
                Divide your goal into smaller milestones and manageable actions.
            </p>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="momentum-card progress-card h-100">
            <h3 class="text-success">See Your Progress</h3>
            <p>
                Complete small actions and watch your progress build over time.
            </p>
        </div>
    </div>
</div>
<div class="row mt-4">
    <div class="col-lg-10 mx-auto">
        <div class="momentum-image-box">
            <img src="~/Images/progress.jpg"
                 alt="Progress toward a goal"
                 class="momentum-image" />
        </div>
    </div>
</div>