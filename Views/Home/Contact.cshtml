@{
    ViewData["Title"] = "Contact";
}

<div class="row">
    <div class="col-sm-12">
        <div class="momentum-header">
            <h1>Contact Momentum</h1>
            <p class="lead mb-0">
                Have a question or need help getting started?
            </p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <h2 class="momentum-accent">Get in Touch</h2>

        <p>
            Momentum is designed to help make big goals feel more manageable.
            Contact us with questions, feedback, or suggestions.
        </p>

        <p>
            <strong>Email:</strong> support@momentum.com
        </p>
    </div>

    <div class="col-md-6">
        <div class="momentum-card">
            <h3 class="text-success">Keep Moving Forward</h3>
            <p>
                Progress does not have to happen all at once.
                One small step is still progress.
            </p>
        </div>
    </div>
</div>