@{
    ViewData["Title"] = "About";
}

<div class="row">
    <div class="col-sm-12">
        <div class="momentum-header">
            <h1>About Momentum</h1>
            <p class="lead mb-0">
                Small steps can create big changes.
            </p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-7">
        <h2 class="momentum-accent">Why Momentum?</h2>

        <p>
            Big goals can feel overwhelming. Momentum is designed to help users
            break large goals into smaller milestones and simple actions that
            feel easier to complete.
        </p>

        <p>
            Instead of focusing only on the final result, Momentum helps users
            see the progress they are making along the way.
        </p>
    </div>

    <div class="col-md-5">
        <div class="momentum-card">
            <h3 class="text-success">The Process</h3>

            <p>Big Goal</p>
            <p>↓</p>
            <p>Milestones</p>
            <p>↓</p>
            <p>Small Actions</p>
            <p>↓</p>
            <p>Progress</p>
        </div>
    </div>
</div>
<div class="row mt-4">
    <div class="col-lg-10 mx-auto">
        <div class="momentum-image-box">
            <img src="~/Images/steps.jpg"
                 alt="Step by step progress"
                 class="about-image" />
        </div>
    </div>
</div>