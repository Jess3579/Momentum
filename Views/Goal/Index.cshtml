@model IEnumerable<Momentum.Models.Goal>

@{
    ViewData["Title"] = "Goals";
}

<div class="row">
    <div class="col-sm-12">
        <div class="momentum-header">
            <h1>Your Goals</h1>
            <p class="lead mb-0">
                Big goals become manageable when you take them one step at a time.
            </p>
        </div>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-success">Create New Goal</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TargetDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.Category)
            </td>
            <td>
                @Html.DisplayFor(model => item.TargetDate)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.GoalId" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.GoalId" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.GoalId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
